{
  "name": "park-lens",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that shows city parking near the place you're viewing in Google Maps (Kitchener and Waterloo, ON).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "data": "npm run data:fetch && npm run data:build",
    "data:fetch": "node scripts/fetch-data.ts",
    "data:build": "node scripts/build-data.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
